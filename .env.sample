# 実際の値はローカルの .env に記入する。以下の例はプレースホルダー。

# 例: http://<strata-host>:8081/metrics
# 既定値: なし（必須）
STRATA_MONITOR_URL=

# 例: <Strataで設定したAPIキー>
# 既定値: 空欄（認証ヘッダーなし）
STRATA_API_KEY=

# 例: http://<xangi-host>:<port>/api/usage
# 既定値: なし（必須）
XANGI_USAGE_URL=

# 例: <待受アドレス>
# 既定値: 0.0.0.0
HOST=

# 例: <待受ポート>
# 既定値: 8090
PORT=

# 例: <地域/都市>
# 既定値: Asia/Tokyo
TZ=

# 例: ./<データフォルダ>
# 既定値: ./data
DATA_DIR=

# 例: <日本語フォントファイル>
# 既定値: なし（必須）
FONT_PATH=

# 例: <太字の日本語フォントファイル>
# 既定値: FONT_PATH と同じ
FONT_PATH_BOLD=

# 例: <provider-id>,<provider-id>
# 既定値: claude-code,codex,antigravity
USAGE_ORDER=

# 例: <provider-id>:<group-id>,<provider-id>:<group-id>
# 既定値: 空（非表示指定なし）
USAGE_HIDE=

# 例: <user>@<deploy-host>
# 既定値: なし（deploy時に必須、開発側のみ）
DEPLOY_TARGET=

# 例: ~/<アプリ専用フォルダ>
# 既定値: なし（deploy時に必須、開発側のみ）
DEPLOY_DIR=
