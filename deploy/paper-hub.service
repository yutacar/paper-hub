[Unit]
Description=paper-hub dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/paper-hub
EnvironmentFile=%h/paper-hub/.env
ExecStart=%h/paper-hub/.venv/bin/python -m paperhub.server
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
